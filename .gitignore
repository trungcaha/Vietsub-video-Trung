# Báo cáo sản xuất sinh cục bộ trong dự án
BAO_CAO_SAN_XUAT.md

# Python cache & môi trường
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/

# Biến môi trường & secret
.env
.env.*

# Hệ điều hành
.DS_Store
Thumbs.db

# Giữ nguyên ảnh minh họa & tài sản mẫu trong assets/
!assets/
!assets/*.jpg
!assets/*.png
